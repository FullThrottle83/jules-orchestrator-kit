# Google Jules Orchestration Kit - Environment Configuration Example
# Copy this file to .env and populate with your credentials/settings.

# --- Authentication & Core Settings ---
# Google Jules API Key (Required for direct REST API dispatches)
JULES_API_KEY=your_google_jules_api_key_here

# Alias for API key (fallback if JULES_API_KEY is not set)
# GEMINI_API_KEY=your_gemini_api_key_here

# Override the Jules REST API URL
# JULES_API_URL=https://jules.googleapis.com/v1alpha/sessions

# Target GitHub Repository (Format: owner/repo)
JULES_REPO=owner/repo

# Set to "true" or "1" to run in repoless/serverless mode
# JULES_REPOLESS=false

# Enable Dry-Run mode to simulate payload dispatch without making API calls
# JULES_DRY_RUN=false

# --- Execution Scope & Git ---
# Base Branch for PR Audits & Merge-Base Calculations (Default: main)
BASE_BRANCH=main

# PR Head Branch (Used by CI to dynamically target branches during OODA repair)
# GITHUB_HEAD_REF=my-feature-branch

# Root directory of the project (Auto-assigned during swarm executions)
# JULES_PROJECT_ROOT=/path/to/project

# --- Swarm & Concurrency ---
# Maximum parallel dispatches for swarm runs (Default: 3)
JULES_SWARM_CONCURRENCY=3

# Dispatch Stagger Interval in Milliseconds (Default: 1500)
JULES_SWARM_STAGGER_MS=1500

# Rate-limit for the jules:queue command (Default: 500)
# JULES_PACE_MS=500

# Use Git Worktrees instead of cloning for swarm isolation
# JULES_USE_WORKTREES=false

# Current slot index for partitioning tasks (Swarm mode)
# JULES_SLOT_INDEX=1

# Total number of slots for partitioning tasks (Swarm mode)
# JULES_SLOT_TOTAL=3

# --- CI & Output ---
# Is this running in a CI environment? (Changes log output and fail-fast behaviors)
# CI=true

# Allow OODA Auto-Repair even in CI environments
# ALLOW_AUTO_REPAIR=true

# GitHub Actions Step Summary File Path
# GITHUB_STEP_SUMMARY=/path/to/step_summary.md

# Disable color in terminal output
# NO_COLOR=true
