# Agent Orchestrator Kit - Environment Configuration Example
# Copy this file to .env and populate with your credentials/settings.
#
# ---------------------------------------------------------------------------
# NAMING: every JULES_* variable below also answers to an AGENT_* spelling
# (AGENT_API_KEY, AGENT_REPO, AGENT_SWARM_CONCURRENCY, ...). Prefer AGENT_* —
# these knobs are not Jules-specific, and the kit dispatches to Claude Code,
# Codex and the Gemini CLI as well. A JULES_* value already in the environment
# always wins, so adding the alias can never change a working setup.
# See src/env-aliases.mjs for the full table.
# ---------------------------------------------------------------------------

# --- Provider selection ---
# Which agent runs the task is set in .agent/config.yml:
#     provider: jules | claude-code | codex | gemini-flash
# Check what this machine can actually reach with:  agentctl providers
#
# Only the hosted Jules provider needs a key here. The CLI providers
# (claude-code, codex, gemini) authenticate themselves and need nothing below.

# --- Authentication & Core Settings ---
# Hosted provider API key (required only for provider: jules)
AGENT_API_KEY=your_google_jules_api_key_here
# Legacy spelling, still honoured:
# JULES_API_KEY=your_google_jules_api_key_here

# Alias for API key (fallback if JULES_API_KEY is not set)
# GEMINI_API_KEY=your_gemini_api_key_here

# Required by the Gemini CLI (`gemini`) when router.fast uses the built-in
# "gemini-flash" preset (Dynamic Complexity & Cost Router, .agent/config.yml
# router.enabled: true). Install: npm i -g @google/gemini-cli
# GEMINI_API_KEY=your_gemini_api_key_here

# Override the Jules REST API URL
# JULES_API_URL=https://jules.googleapis.com/v1alpha/sessions

# Target GitHub Repository (Format: owner/repo) — hosted provider only
AGENT_REPO=owner/repo

# Set to "true" or "1" to run in repoless/serverless mode
# JULES_REPOLESS=false

# Enable Dry-Run mode to simulate payload dispatch without making API calls
# JULES_DRY_RUN=false

# --- Budget & Security Gatekeeper ---
# Daily max session limit for autonomous dispatches (Default: 300)
# JULES_DAILY_BUDGET=300

# Allow modifications to command-defining files (package.json, Cargo.toml, etc.) in PRs (Default: false)
# JULES_ALLOW_COMMAND_FILE_CHANGES=false

# Allow modifications to agent rule files (AGENTS.md, JULES_RULES_TEMPLATE.md, .agent/rules/**) in PRs (Default: false)
# JULES_ALLOW_AGENT_RULE_CHANGES=false

# --- Execution Scope & Git ---
# Base Branch for PR Audits & Merge-Base Calculations (Default: main)
BASE_BRANCH=main

# PR Head Branch (Used by CI to dynamically target branches during OODA repair)
# GITHUB_HEAD_REF=my-feature-branch

# Root directory of the project (Auto-assigned during swarm executions)
# JULES_PROJECT_ROOT=/path/to/project

# --- Swarm & Concurrency ---
# Maximum parallel dispatches for swarm runs (Default: 3)
AGENT_SWARM_CONCURRENCY=3

# Dispatch Stagger Interval in Milliseconds (Default: 1500)
AGENT_SWARM_STAGGER_MS=1500

# Rate-limit for the jules:queue command (Default: 500)
# JULES_PACE_MS=500

# Use Git Worktrees instead of cloning for swarm isolation
# JULES_USE_WORKTREES=false

# Current slot index for partitioning tasks (Swarm mode)
# JULES_SLOT_INDEX=1

# Total number of slots for partitioning tasks (Swarm mode)
# JULES_SLOT_TOTAL=3

# --- CI & Output ---
# Is this running in a CI environment? (Changes log output and fail-fast behaviors)
# CI=true

# Allow OODA Auto-Repair even in CI environments
# ALLOW_AUTO_REPAIR=true

# GitHub Actions Step Summary File Path
# GITHUB_STEP_SUMMARY=/path/to/step_summary.md

# Disable color in terminal output
# NO_COLOR=true

# --- Verification depth ---
# How hard the gate verifies an agent's work is set in .agent/config.yml:
#     verify:
#       profile: minimal | standard | max
# Inspect what a profile expands to on this stack:  agentctl profile
