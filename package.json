{
  "name": "jules-orchestrator-kit",
  "version": "0.20.0",
  "description": "Orchestration kit for running Google Jules autonomous agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FullThrottle83/jules-orchestrator-kit.git"
  },
  "bugs": {
    "url": "https://github.com/FullThrottle83/jules-orchestrator-kit/issues"
  },
  "homepage": "https://github.com/FullThrottle83/jules-orchestrator-kit#readme",
  "type": "module",
  "bin": {
    "agentctl": "bin/agentctl.mjs",
    "jules-init": "bin/init.js",
    "jules-orchestrator-kit": "bin/agentctl.mjs",
    "jules-mcp": "bin/mcp-server.mjs",
    "agentctl-mcp": "bin/mcp-server.mjs"
  },
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "src/",
    "bin/",
    "scripts/",
    ".agent/jules.yml",
    ".agent/rules/",
    ".agent/prompts/",
    ".agent/workflows/",
    ".agent/jules-queue/README.md",
    ".github/workflows/jules-audit.yml",
    ".env.example",
    "JULES_RULES_TEMPLATE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "init": "node bin/init.js",
    "test": "node --test test/*.test.mjs",
    "jules:dispatch": "node scripts/jules-dispatch.mjs",
    "jules:queue": "node scripts/jules-queue-runner.mjs",
    "jules:create": "node scripts/jules-create.mjs",
    "jules:status": "node scripts/jules-status.mjs",
    "jules:audit": "node scripts/jules-self-audit.mjs",
    "jules:cleanup": "node scripts/jules-cleanup.mjs",
    "jules:scan": "node scripts/jules-scan-todos.mjs",
    "jules:swarm": "node scripts/jules-swarm.mjs",
    "jules:merge-swarm": "node scripts/jules-merge-swarm.mjs",
    "jules:patch": "node scripts/jules-patch.mjs",
    "jules:nightly": "node scripts/jules-nightly.mjs",
    "jules:webhook": "node scripts/jules-webhook-receiver.mjs",
    "jules:validate-envelope": "node scripts/validate-envelope.mjs",
    "jules:check-stale-base": "node scripts/stale-base-check.mjs",
    "jules:check-asset-integrity": "node scripts/asset-integrity-check.mjs",
    "jules:risk-tier": "node scripts/risk-tier.mjs",
    "jules:rules-lint": "node scripts/rules-lint.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "jules",
    "google-jules",
    "ai-agent",
    "orchestrator",
    "mcp",
    "automation"
  ],
  "author": "FullThrottle83",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.8.0"
  }
}
