{
  "name": "jules-orchestrator-kit",
  "version": "1.3.0",
  "description": "Framework-agnostic toolkit for orchestrating Google Jules background AI coding workers.",
  "type": "module",
  "bin": {
    "jules-init": "./bin/init.js"
  },
  "scripts": {
    "init": "node bin/init.js",
    "test": "node --test test/kit.test.mjs",
    "jules:dispatch": "node scripts/jules-dispatch.mjs",
    "jules:queue": "node scripts/jules-queue-runner.mjs",
    "jules:audit": "node scripts/jules-self-audit.mjs",
    "jules:swarm": "node scripts/jules-swarm.mjs",
    "jules:nightly": "python3 scripts/jules-nightly.py"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "jules",
    "google-jules",
    "ai-agent",
    "orchestrator",
    "mcp",
    "automation"
  ],
  "author": "Jonas (FullThrottle83)",
  "license": "MIT"
}

